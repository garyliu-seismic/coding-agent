# ---- DeepSeek (OpenAI-compatible) ----
# Required
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Base URL for DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Model id. DeepSeek's general chat model. If your "V4 Flash" has a different
# id/endpoint, point DEEPSEEK_BASE_URL + DEEPSEEK_MODEL to it.
DEEPSEEK_MODEL=deepseek-chat

# ---- Optional ----
# Default project root the agent works on (defaults to current directory)
# CODING_AGENT_ROOT=C:\path\to\your\project
# Lock down the agent to read-only (no edits, no shell commands)
# CODING_AGENT_READ_ONLY=0
