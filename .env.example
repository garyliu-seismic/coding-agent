# ---- Default: DeepSeek (OpenAI-compatible) ----
# Required
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Base URL for DeepSeek (OpenAI-compatible endpoint)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# Model id. DeepSeek's general chat model.
DEEPSEEK_MODEL=deepseek-chat

# ---- Alternative: Local Ollama (OpenAI-compatible, no API key) ----
# To run against a local Ollama server instead, set these and leave the
# API key empty:
# DEEPSEEK_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_MODEL=ornith-1.5:9b
# Install/pull the model with:  ollama pull ornith-1.5:9b

# ---- Azure AI Foundry / Azure OpenAI (OpenAI-compatible v1 endpoint) ----
# DEEPSEEK_BASE_URL=https://<resource>.openai.azure.com/openai/v1
# DEEPSEEK_API_KEY=<azure key>
# DEEPSEEK_MODEL=<deployment name, not the model name>
# GPT-5 family deployments may reject temperature=0; omit it with:
# CODING_AGENT_TEMPERATURE=none

# ---- Vision / describe_image backend (default: gpt-5-mini) ----
# The describe_image tool uses a separate vision model endpoint.
# It defaults to gpt-5-mini via the same DEEPSEEK_BASE_URL / DEEPSEEK_API_KEY.
# Override only if you want a different endpoint or model for vision:
# CODING_AGENT_VISION_MODEL_URL=https://garyliufoundry1.services.ai.azure.com/openai/v1
# CODING_AGENT_VISION_MODEL_NAME=gpt-5-mini
# CODING_AGENT_VISION_API_KEY=<azure-or-openai-key>
# To use a local Ollama vision model instead:
# CODING_AGENT_VISION_MODEL_URL=http://localhost:11434/v1
# CODING_AGENT_VISION_MODEL_NAME=qwen3.8:latest
# CODING_AGENT_VISION_TIMEOUT=60
# CODING_AGENT_VISION_MAX_RETRIES=3

# ---- Optional ----
# Default project root the agent works on (defaults to current directory)
# CODING_AGENT_ROOT=C:\path\to\your\project
# Lock down the agent to read-only (no edits, no shell commands)
# CODING_AGENT_READ_ONLY=0
